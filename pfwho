class Macro:
    __slots__ = ("name", "value", "file", "line", "uses")

    def __init__(self, name, value, file, line):
        self.name, self.value = name, value
        self.file, self.line = file, line
        self.uses = 0

    def where(self):
        return "%s:%d" % (self.file, self.line)
        self.uses = 0


def expand_macros(text, macros, file, line, depth=0, seen=()):
    """Expand $name outside quotes (PF13). Undefined or use-before-def
    (the macro table only holds definitions seen so far) = fatal.
    Recursive definitions = fatal naming the cycle."""
    if depth > 32:
        raise ConfigError("%s:%d: macro expansion too deep" % (file, line))
    out = []
    i, n = 0, len(text)
    inq = False
    while i < n:
        ch = text[i]
        if ch == '"':
            inq = not inq
            out.append(ch)
            i += 1
            continue
        if ch == "$" and not inq:
            m = re.match(r"\$([A-Za-z_][A-Za-z0-9_]*)", text[i:])
            if m:
                name = m.group(1)
                if name in LABEL_BUILTINS:
                    out.append("$" + name)
                    i += len(name) + 1
                    continue
                if name in seen:
                    raise ConfigError(
                        "%s:%d: recursive macro definition: %s" %
                        (file, line, " -> ".join(seen + (name,))))
                mac = macros.get(name)
                if mac is None:
                    raise ConfigError(
                        "%s:%d: undefined macro $%s (macros must be "
                        "defined before use)" % (file, line, name))
                mac.uses += 1
                out.append(expand_macros(mac.value, macros, file, line,
                                         depth + 1, seen + (name,)))
                i += len(name) + 1
                continue
            out.append(ch)
            i += 1
            continue
        out.append(ch)
        i += 1
    return "".join(out)


