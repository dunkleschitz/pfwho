def load_name_tables():
    """PF15: built-in tables plus /etc/services and /etc/protocols when
    present (data files, never the network)."""
    global _name_tables_loaded
    if _name_tables_loaded:
        return
    _name_tables_loaded = True
    try:
        with open("/etc/services") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) < 2 or "/" not in parts[1]:
                    continue
                try:
                    num = int(parts[1].split("/")[0])
                except ValueError:
                    continue
                PORT_NAMES.setdefault(parts[0], num)
                for alias in parts[2:]:
                    if alias.startswith("#"):
                        break
                    PORT_NAMES.setdefault(alias, num)
    except OSError:
        pass
    try:
        with open("/etc/protocols") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) < 2:
                    continue
                try:
                    num = int(parts[1])
                except ValueError:
                    continue
                PROTO_NAMES.setdefault(parts[0], num)
    except OSError:
        pass


def parse_port_value(tok, file, line):
    load_name_tables()
    if tok.isdigit():
        v = int(tok)
        if 0 <= v <= 65535:
            return v
        raise ConfigError("%s:%d: port %s out of range" % (file, line, tok))
    if tok in PORT_NAMES:
        return PORT_NAMES[tok]
    raise ConfigError("%s:%d: unknown port name %r" % (file, line, tok))


def parse_proto_value(tok, file, line):
    load_name_tables()
    if tok.isdigit():
        return int(tok)
    if tok.lower() in PROTO_NAMES:
        return PROTO_NAMES[tok.lower()]
    raise ConfigError("%s:%d: unknown protocol name %r" % (file, line, tok))


def proto_name(num):
    return PROTO_BY_NUM.get(num, str(num))


def parse_tos_value(tok):
    if tok in TOS_NAMES:
        return TOS_NAMES[tok]
    try:
        return int(tok, 0)
    except ValueError:
        return None


# ------------------------------------------------------- logical lines

class LLine:
    __slots__ = ("file", "line", "text")

    def __init__(self, file, line, text):
        self.file, self.line, self.text = file, line, text

    def where(self):
        return "%s:%d" % (self.file, self.line)


def _strip_comment(text):
    """Remove a # comment outside quotes from one physical line."""
    out = []
    inq = False
    for ch in text:
        if ch == '"':
            inq = not inq
            out.append(ch)
        elif ch == "#" and not inq:
            break
        else:
            out.append(ch)
    return "".join(out)


def read_logical_lines(path):
    """Read a file into logical lines: backslash continuations joined,
    comments stripped, each logical line citing its FIRST physical
    line (PF-files)."""
    try:
        with open(path) as fh:
            physical = fh.read().splitlines()
    except OSError as e:
        raise ConfigError("cannot read %s: %s" % (path, e.strerror or e))
    out = []
    buf = None
    start = 0
    for idx, raw in enumerate(physical, 1):
        line = _strip_comment(raw)
        cont = line.rstrip().endswith("\\")
        if cont:
            line = line.rstrip()[:-1]
        if buf is None:
            buf = line
            start = idx
        else:
            buf = buf + " " + line.strip()
        if not cont:
            if buf.strip():
                out.append(LLine(path, start, buf.strip()))
            buf = None
    if buf is not None and buf.strip():
        out.append(LLine(path, start, buf.strip()))
    return out


def expand_includes(path, chain, files_read):
    """Textually expand `include` statements in place (PF-files).
    Returns a flat list of LLine. Missing file / cycle = config-fatal.
    files_read collects paths in expansion order."""
    apath = os.path.abspath(path)
    if apath in chain:
        raise ConfigError("include cycle: %s" %
                          " -> ".join(chain + [apath]))
    if not os.path.exists(path):
        raise ConfigError("include file not found: %s (chain: %s)" %
                          (path, " -> ".join(chain + [apath])))
    files_read.append(path)
    lines = read_logical_lines(path)
    out = []
    for ll in lines:
        toks = tokenize(ll.text)
        if toks and toks[0].text == "include":
            if len(toks) != 2:
                raise ConfigError("%s: malformed include" % ll.where())
            inc = toks[1].text
            out.extend(expand_includes(inc, chain + [apath], files_read))
        else:
            out.append(ll)
    return out


# ------------------------------------------------------------ tokenizer

class Tok:
    __slots__ = ("text", "quoted")

    def __init__(self, text, quoted=False):
        self.text, self.quoted = text, quoted

    def __repr__(self):
        return "Tok(%r%s)" % (self.text, ",q" if self.quoted else "")


def tokenize(text):
    """Whitespace tokenize with {}(), kept separate, quotes preserved
    as quoted tokens, and `!` split from the following term when it is
    a negation rather than the != operator."""
    toks = []
    i, n = 0, len(text)
    while i < n:
        ch = text[i]
        if ch.isspace():
            i += 1
            continue
        if ch == '"':
            j = text.find('"', i + 1)
            if j < 0:
                toks.append(Tok(text[i + 1:], True))
                break
            toks.append(Tok(text[i + 1:j], True))
            i = j + 1
            continue
        if ch in "{}(),":
            toks.append(Tok(ch))
            i += 1
            continue
        j = i
        while j < n and not text[j].isspace() and text[j] not in '{}(),"':
            j += 1
        word = text[i:j]
        if word.startswith("!") and not word.startswith("!=") \
                and len(word) > 1:
            toks.append(Tok("!"))
            word = word[1:]
        toks.append(Tok(word))
        i = j
    return toks


