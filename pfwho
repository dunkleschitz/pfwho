class AddrTerm:
    """One address term. kind: any|net|range|table|iface|self|hostname|
    noroute|urpf|route. data per kind."""
    __slots__ = ("kind", "net", "lo", "hi", "name", "modifier", "parens",
                 "display")

    def __init__(self, kind, display, net=None, lo=None, hi=None,
                 name=None, modifier=None, parens=False):
        self.kind, self.display = kind, display
        self.net, self.lo, self.hi = net, lo, hi
        self.name, self.modifier, self.parens = name, modifier, parens


class PortSpec:
    """op in eq|ne|lt|le|gt|ge|range|xrange|except; a,b bounds."""
    __slots__ = ("op", "a", "b", "display")

    def __init__(self, op, a, b, display):
        self.op, self.a, self.b, self.display = op, a, b, display

    def matches(self, port):
        a, b = self.a, self.b
        if self.op == "eq":
            return port == a
        if self.op == "ne":
            return port != a
        if self.op == "lt":
            return port < a
        if self.op == "le":
            return port <= a
        if self.op == "gt":
            return port > a
        if self.op == "ge":
            return port >= a
        if self.op == "range":
            return a <= port <= b
        if self.op == "xrange":
            return a < port < b
        if self.op == "except":
            return port < a or port > b
        return False

    def lo_bound(self):
        return self.a


